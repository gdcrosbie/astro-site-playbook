---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const sampleEntries = await getCollection('sample');
const cards = sampleEntries
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order);
---

<BaseLayout>
  <main id="main-content">
    <section class="l-section c-playbook-hero" aria-labelledby="hero-title">
      <div class="l-container">
        <span class="c-playbook-hero__badge">Astro Site Playbook</span>
        <h1 id="hero-title" class="c-playbook-hero__title">Build sites with a shared playbook.</h1>
        <p class="c-playbook-hero__lead">
          A runnable Astro starter, human-readable methodology, and agent skill for accessible, high-performance website delivery.
        </p>

        <div class="c-playbook-hero__grid">
          {cards.map((card) => (
            <div class="c-playbook-hero__col">
              <Card title={card.title} description={card.description} href={card.href} />
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .c-playbook-hero {
    min-block-size: 80vh;
    display: flex;
    align-items: center;
  }

  .c-playbook-hero__badge {
    display: inline-block;
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
    margin-block-end: var(--space-s);
  }

  .c-playbook-hero__title {
    font-family: var(--font-display);
    font-size: var(--h1);
    line-height: 1.1;
    color: var(--color-primary);
    margin-block-end: var(--space-m);
    max-inline-size: 18ch;
  }

  .c-playbook-hero__lead {
    font-size: var(--text-l);
    color: var(--color-muted);
    line-height: 1.6;
    max-inline-size: 45ch;
    margin-block-end: var(--space-2xl);
  }

  .c-playbook-hero__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-l);
  }

  .c-playbook-hero__col {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 900px) {
    .c-playbook-hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
