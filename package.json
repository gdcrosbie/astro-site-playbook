{
  "name": "astro-site-playbook",
  "type": "module",
  "version": "1.0.0",
  "description": "An opinionated system for delivering accessible, high-performance Astro sites with a shared human and agent playbook.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gdcrosbie/astro-site-playbook.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:docs": "node scripts/test-doc-links.cjs",
    "test:tokens": "node scripts/test-tokens.cjs",
    "test:contrast": "node scripts/test-contrast.cjs",
    "test:social-image": "node scripts/test-social-image.cjs",
    "test:forms": "node --experimental-strip-types --test scripts/test-contact-form.mjs",
    "test:a11y": "node scripts/run-axe.cjs",
    "test:template": "node scripts/test-template-copy.cjs",
    "test": "npm run test:docs && npm run test:tokens && npm run test:contrast && npm run check && npm run build && npm run test:social-image && npm run test:forms && npm run test:a11y",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "astro": "^7.3.1",
    "cookie": "^2.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0"
  }
}
